{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ff7",
      "destination": "/index.html"
    },
    {
      "source": "/ff7/",
      "destination": "/index.html"
    },
    {
      "source": "/ff7/:path*",
      "destination": "/:path*"
    }
  ],
  "functions": {
    "api/expert.mjs": {
      "maxDuration": 90,
      "includeFiles": "lib/knowledge.json"
    }
  }
}
